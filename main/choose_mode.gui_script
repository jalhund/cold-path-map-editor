local gooey = require "gooey.gooey"
local exported_map_format = require "scripts.exported_map_format"
local cli = require "scripts.cli"

local MAP_EDITOR_TEXT = "Map editor"
local CONVERT_LEGACY_TEXT = "Convert legacy map"
local CONVERT_PACKAGE_TEXT = "Convert to .map"
local OPTIMIZE_PACKAGE_TEXT = "Optimize .map"

local function set_map_editor_text(text)
	gui.set_text(gui.get_node("map_editor_text"), text)
end

-- Detect the current map format, cleaning up stray legacy artifacts that sit
-- next to an already new-format map. Returns the detect_format() table.
local function normalize_detected()
	local detected = exported_map_format.detect_format()
	if exported_map_format.is_new_format(detected.map_data) and exported_map_format.has_legacy_artifacts() then
		exported_map_format.cleanup_legacy_artifacts()
		detected = exported_map_format.detect_format()
	end

	return detected
end

-- A package/folder still using the old padded layout can be shrunk in place.
local function detected_needs_optimization(detected)
	return (detected.kind == "package" or detected.kind == "folder")
		and exported_map_format.needs_layout_optimization(detected.map_data)
end

local function get_map_editor_button_text(detected)
	if detected.kind == "legacy" then
		return CONVERT_LEGACY_TEXT
	end

	if detected_needs_optimization(detected) then
		return OPTIMIZE_PACKAGE_TEXT
	end

	if detected.kind == "folder" then
		return CONVERT_PACKAGE_TEXT
	end

	return MAP_EDITOR_TEXT
end

local function refresh_map_editor_button()
	set_map_editor_text(get_map_editor_button_text(normalize_detected()))
end

function init(self)
	msg.post(".", "acquire_input_focus")
	if cli.is_enabled() then
		gui.set_enabled(gui.get_node("main"), false)
		return
	end
	refresh_map_editor_button()
end

function on_input(self, action_id, action)
	gooey.button("map_creator/outline", action_id, action, function()
		msg.post("main:/go#main", "load_creator")
		gui.set_enabled(gui.get_node("main"), false)
	end, update_button_menu)
	gooey.button("map_editor/outline", action_id, action, function()
		local detected = normalize_detected()
		local needs_optimization = detected_needs_optimization(detected)

		if detected.kind == "legacy" or detected.kind == "folder" or needs_optimization then
			set_map_editor_text(needs_optimization and "Optimizing..." or "Converting...")
			-- write_map_package unpacks (if needed), shrinks padded maps and repacks.
			local ok = exported_map_format.write_map_package()
			refresh_map_editor_button()
			if not ok then
				set_map_editor_text(get_map_editor_button_text(normalize_detected()))
			else
				msg.post("main:/go#main", "load_editor")
				gui.set_enabled(gui.get_node("main"), false)
			end
		else
			msg.post("main:/go#main", "load_editor")
			gui.set_enabled(gui.get_node("main"), false)
		end
	end, update_button_menu)
end
